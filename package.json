{
  "name": "watson-cdi",
  "version": "6.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:migrate": "node db/postgres/migrate.mjs",
    "db:deploy:ibm": "node db/postgres/deploy.mjs",
    "db:seed:ibm": "node db/postgres/seed.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:ibm": "WATSON_CDI_RUNTIME=ibm next dev --hostname 0.0.0.0 --port 8080",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:ibm": "WATSON_CDI_RUNTIME=ibm next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:ibm": "WATSON_CDI_RUNTIME=ibm HOSTNAME=0.0.0.0 PORT=${PORT:-8080} node .next/standalone/server.js",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:runtime": "node --experimental-strip-types --test tests/v6-runtime.test.mjs",
    "test:ibm": "npm run build:ibm && npm run test:runtime",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:migrate:postgres": "node db/postgres/migrate.mjs",
    "db:seed:postgres": "node db/postgres/seed.mjs"
  },
  "dependencies": {
    "@carbon/charts-react": "^1.27.16",
    "@carbon/react": "^1.111.1",
    "@xyflow/react": "^12.11.2",
    "drizzle-orm": "0.45.2",
    "ibm-cos-sdk": "^1.15.1",
    "jose": "^6.2.4",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sass": "^1.101.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
