# Provider precedence: watsonx -> Gemini -> deterministic fallback
AI_PROVIDER_MODE=auto

# IBM watsonx (target production provider)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# Temporary test provider. Store GEMINI_API_KEY as a server-side secret.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-2
