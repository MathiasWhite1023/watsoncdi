# IBM Cloud runtime
PLATFORM_TARGET=ibm
WATSON_CDI_RUNTIME=ibm
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=

# IBM Databases for PostgreSQL
DATABASE_URL=
DATABASE_CA_CERT_BASE64=
DATABASE_POOL_MAX=5
# Optional for the admin-only migration job; the app never receives these.
DATABASE_RUNTIME_USER=
DATABASE_RUNTIME_PASSWORD=

# IBM Cloud Object Storage
IBM_COS_ENDPOINT=
IBM_COS_BUCKET=
IBM_COS_API_KEY=
IBM_COS_SERVICE_INSTANCE_ID=

# IBM App ID (Cloud Directory)
APPID_DISCOVERY_URL=
APPID_CLIENT_ID=
APPID_CLIENT_SECRET=

# IBM watsonx (optional; deterministic fallback remains available)
AI_PROVIDER_MODE=auto
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# OpenAI Sites compatibility is disabled in IBM Cloud.
SITES_AUTH_COMPATIBILITY=false
